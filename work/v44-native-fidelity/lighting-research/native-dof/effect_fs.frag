precision highp float;precision highp int;uniform sampler2D sceneTex,fuzzTex;uniform vec2 extent,tapScale;out vec4 o;vec4 scene(vec2 uv){return texture(sceneTex,vec2(uv.x,1.-uv.y));}vec4 fuzz(vec2 uv){return texture(fuzzTex,vec2(uv.x,1.-uv.y));}const vec2 taps[16]=vec2[16](vec2(.402850002,.0401399992),vec2(.127312005,.372079015),vec2(-.287164003,-.523500025),vec2(-.200276002,.55390799),vec2(.177846998,.554831028),vec2(-.49496901,.287847012),vec2(.314258993,.663151979),vec2(.438827008,-.395498991),vec2(-.542695999,.512251973),vec2(.39943099,-.649686992),vec2(-.595748007,-.0997679979),vec2(-.141366005,.0911030024),vec2(.721309006,.206925005),vec2(-.434475988,-.411615998),vec2(.715196013,-.266535997),vec2(.178103998,.747582972));void main(){vec2 uv=vec2(gl_FragCoord.x,extent.y-gl_FragCoord.y)/extent;vec4 center=fuzz(uv);float reduce=center.z>0.?.5:1.;vec3 total=scene(uv).rgb;float weight=1.;for(int i=0;i<16;i++){vec2 q=uv+center.x*(tapScale*taps[i]);vec4 f=fuzz(q);float w=f.x*(f.y<center.y?reduce:1.);total=scene(q).rgb*w+total;weight=weight+w;}o=vec4(total/weight,center.x);}