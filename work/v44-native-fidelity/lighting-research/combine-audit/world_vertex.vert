#version 300 es
layout(location=0)in vec3 p;layout(location=1)in vec4 n;layout(location=2)in vec4 vertex_color;layout(location=3)in vec2 t;layout(location=4)in vec3 tangent;layout(location=5)in vec3 bitangent;layout(location=6)in vec2 uv_second;layout(location=7)in highp uint packed_wind;layout(location=8)in float radial_length;uniform int material_family;uniform vec4 material_color,material_specular;uniform float leaf_palette[12];uniform int geometry_kind,features;uniform vec4 wind_palette[64];uniform mat4 mvp;uniform vec3 eye;uniform vec2 fog;out vec3 W;out highp vec3 N0;out vec2 UV;out highp float F;out highp float VA;out highp vec4 VC;out highp vec3 TW,BW;out vec2 UV2;flat out highp uint PW;void main(){vec3 pos=p;if(geometry_kind==1&&(features&128)!=0)pos+=wind_palette[packed_wind&255u].xyz;vec3 normal=n.xyz;if(geometry_kind==2&&material_family==6&&(features&128)!=0){vec2 xy=unpackHalf2x16(floatBitsToUint(uv_second.x));vec2 zi=unpackHalf2x16(floatBitsToUint(uv_second.y));vec3 delta=vec3(xy,zi.x)*(material_specular.y*leaf_palette[int(zi.y)]);pos+=delta;if(material_color.x<.5)delta.z=0.;normal=normalize(n.xyz*radial_length+delta);}W=pos;N0=normal;VA=(geometry_kind==2&&dot(tangent,tangent)<.1)?length(n.xyz):n.w;VC=vertex_color;PW=packed_wind;UV=t;UV2=uv_second;TW=tangent;BW=bitangent;if(material_family==7){N0=normalize(normal);vec3 seed=vec3(1.,0.,N0.x/N0.z);TW=normalize(seed-N0*dot(seed,N0));BW=cross(N0,TW);}if(geometry_kind==1){TW=normalize(vec3(-n.z,0.,n.x));BW=normalize(cross(n.xyz,TW));}gl_Position=mvp*vec4(pos,1.0);F=1.0-min(exp(-(fog.x*gl_Position.w+fog.y)),1.0);}