#version 300 es
layout(location=0)in vec3 p;layout(location=1)in vec4 n;layout(location=2)in vec4 vertex_color;layout(location=3)in vec2 t;layout(location=4)in vec3 tangent;layout(location=5)in vec3 bitangent;layout(location=6)in vec2 uv_second;layout(location=7)in highp uint packed_wind;uniform int geometry_kind,features;uniform vec4 wind_palette[64];uniform mat4 mvp;uniform vec3 eye;uniform vec2 fog;out vec3 W;out mediump vec3 N0;out vec2 UV;out mediump float F;out mediump float VA;out mediump vec4 VC;out mediump vec3 TW,BW;out vec2 UV2;flat out highp uint PW;void main(){vec3 pos=p;if(geometry_kind==1&&(features&128)!=0)pos+=wind_palette[packed_wind&255u].xyz;W=pos;N0=n.xyz;VA=(geometry_kind==2&&dot(tangent,tangent)<.1)?length(n.xyz):n.w;VC=vertex_color;PW=packed_wind;UV=t;UV2=uv_second;TW=tangent;BW=bitangent;if(geometry_kind==1){TW=normalize(vec3(-n.z,0.,n.x));BW=normalize(cross(n.xyz,TW));}gl_Position=mvp*vec4(pos,1.0);F=1.0-min(exp(-(fog.x*gl_Position.w+fog.y)),1.0);}