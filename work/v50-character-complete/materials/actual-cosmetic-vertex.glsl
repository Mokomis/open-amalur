#version 300 es
layout(location=0)in vec3 p;layout(location=1)in uvec4 j;layout(location=2)in vec3 source_weight;layout(location=3)in vec2 source_uv;layout(location=4)in vec3 source_n;layout(location=5)in vec3 source_t;layout(location=6)in vec3 source_b;layout(location=7)in vec4 source_color;layout(location=8)in vec2 source_uv1;uniform mat4 mvp;uniform vec4 char_bones[234],char_entity[3];uniform int char_weighted;uniform vec2 fog;out vec3 W;out highp vec3 N0;out vec2 UV;out highp float F;out highp float VA;out highp vec4 VC;out highp vec3 TW,BW;out vec2 UV2;flat out highp uint PW;vec3 point_at(uint joint,vec3 v){int i=int(joint)*3;vec4 q=vec4(v,1.);return vec3(dot(char_bones[i],q),dot(char_bones[i+1],q),dot(char_bones[i+2],q));}vec3 dir_at(uint joint,vec3 v){int i=int(joint)*3;return vec3(dot(char_bones[i].xyz,v),dot(char_bones[i+1].xyz,v),dot(char_bones[i+2].xyz,v));}vec3 skin_point(vec3 v,vec4 w){vec3 r=point_at(j.y,v)*w.y;r=point_at(j.x,v)*w.x+r;r=point_at(j.z,v)*w.z+r;return point_at(j.w,v)*w.w+r;}vec3 skin_dir(vec3 v,vec4 w){vec3 r=dir_at(j.y,v)*w.y;r=dir_at(j.x,v)*w.x+r;r=dir_at(j.z,v)*w.z+r;return dir_at(j.w,v)*w.w+r;}void main(){vec4 w=vec4(source_weight,1.-dot(source_weight,vec3(1.)));W=char_weighted!=0?skin_point(p,w):point_at(0u,p);N0=normalize(char_weighted!=0?skin_dir(source_n,w):dir_at(0u,source_n));TW=normalize(char_weighted!=0?skin_dir(source_t,w):dir_at(0u,source_t));BW=normalize(vec3(dot(char_entity[0].xyz,source_b),dot(char_entity[1].xyz,source_b),dot(char_entity[2].xyz,source_b)));VC=source_color;VA=source_color.a;UV=source_uv;UV2=source_uv1;PW=0u;gl_Position=mvp*vec4(W,1.);F=1.-min(exp(-(fog.x*gl_Position.w+fog.y)),1.);}