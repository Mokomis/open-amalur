#version 300 es
layout(location=0)in vec3 p;layout(location=1)in ivec4 j;layout(location=2)in vec4 source_weight;layout(location=3)in vec2 source_uv;layout(location=4)in vec4 source_n;layout(location=5)in vec4 source_t;layout(location=6)in vec4 source_b;layout(location=7)in vec4 source_color;uniform mat4 mvp;uniform vec4 char_bones[234];uniform vec2 char_facing_sc;uniform vec2 fog;out vec3 W;out highp vec3 N0;out vec2 UV;out highp float F;out highp float VA;out highp vec4 VC;out highp vec3 TW,BW;out vec2 UV2;flat out highp uint PW;vec3 point_at(int joint,vec3 v){int i=joint*3;vec4 q=vec4(v,1.);return vec3(dot(char_bones[i],q),dot(char_bones[i+1],q),dot(char_bones[i+2],q));}vec3 dir_at(int joint,vec3 v){int i=joint*3;return vec3(dot(char_bones[i].xyz,v),dot(char_bones[i+1].xyz,v),dot(char_bones[i+2].xyz,v));}vec3 skin_point(vec3 v,vec4 w){vec3 r=point_at(j.y,v)*w.y;r=point_at(j.x,v)*w.x+r;r=point_at(j.z,v)*w.z+r;return point_at(j.w,v)*w.w+r;}vec3 skin_dir(vec3 v,vec4 w){vec3 r=dir_at(j.y,v)*w.y;r=dir_at(j.x,v)*w.x+r;r=dir_at(j.z,v)*w.z+r;return dir_at(j.w,v)*w.w+r;}void main(){vec4 w=vec4(source_weight.xyz,dot(vec4(-1.,-1.,-1.,1.),vec4(source_weight.xyz,1.)));W=skin_point(p,w);N0=normalize(skin_dir(source_n.xyz,w));TW=normalize(skin_dir(source_t.xyz,w));vec3 b=source_b.xyz;BW=normalize(vec3(char_facing_sc.y*b.x-char_facing_sc.x*b.y,char_facing_sc.x*b.x+char_facing_sc.y*b.y,b.z));VC=source_color;VA=source_color.a;UV=source_uv;UV2=vec2(0.);PW=0u;gl_Position=mvp*vec4(W,1.);F=1.-min(exp(-(fog.x*gl_Position.w+fog.y)),1.);}