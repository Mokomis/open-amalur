+#include "oa_camera_offsets.inc"
+void VulkanReplayFrameLoopConsumer::OaApplyCamera() {
+    if(oa_camera_baseline_.empty())return;
+    auto p=oa_camera::Read();float current[4]={p.yaw,p.pitch,p.right,p.forward};
