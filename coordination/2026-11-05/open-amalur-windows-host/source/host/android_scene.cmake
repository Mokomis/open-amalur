# Include explicitly from the enclosing CMakeLists when the viewer is integrated.
# The authored scene.bin asset is supplied by the verified importer, not generated
# or substituted here. No APK packaging/build tools are downloaded by CMake.
add_library(amalur_scene_mesh STATIC src/amalur_scene_mesh.c)
target_include_directories(amalur_scene_mesh PUBLIC include)
if(NOT WIN32)
  target_link_libraries(amalur_scene_mesh PUBLIC m)
endif()
if(MSVC)
  target_compile_definitions(amalur_scene_mesh PRIVATE _CRT_SECURE_NO_WARNINGS)
  target_compile_options(amalur_scene_mesh PRIVATE /W4)
else()
  target_compile_options(amalur_scene_mesh PRIVATE -Wall -Wextra -Wpedantic)
endif()
add_executable(amalur-scene-mesh-test tests/scene_mesh_test.c)
target_link_libraries(amalur-scene-mesh-test PRIVATE amalur_scene_mesh)
add_executable(amalur-scene-mesh-inspect src/scene_mesh_inspect.c)
target_link_libraries(amalur-scene-mesh-inspect PRIVATE amalur_scene_mesh)
if(MSVC)
  target_compile_definitions(amalur-scene-mesh-inspect PRIVATE _CRT_SECURE_NO_WARNINGS)
endif()
if(ANDROID)
  add_library(opem_amalur_scene SHARED android_scene.c room_lighting.c oa_character.c oa_npc.c oa_combat.c oa_character_gl.c oa_sky.c oa_ui.c oa_menu.c oa_items.c oa_stream.c oa_post.c oa_actors.c oa_actor_ai.c oa_nav.c oa_audio.c oa_fx.c oa_adpcm.c exploration_input.c exploration_overlay.c interaction_state.c interaction_pick.c interaction_lua.c interaction_android.c opem_collision.c
    ../v09-textures/scene_materials_v09.c ../v09-textures/scene_material_renderer_v09.c)
  target_include_directories(opem_amalur_scene PRIVATE include ../v09-collision ../v09-textures)
  set(AMALUR_SCENE_SHA256 "" CACHE STRING "Exact packaged scene.bin SHA256 for recovered material sidecar")
  if(NOT AMALUR_SCENE_SHA256 STREQUAL "")
    string(LENGTH "${AMALUR_SCENE_SHA256}" AMALUR_SCENE_HASH_LENGTH)
    if(NOT AMALUR_SCENE_HASH_LENGTH EQUAL 64 OR NOT AMALUR_SCENE_SHA256 MATCHES "^[0-9a-fA-F]+$")
      message(FATAL_ERROR "AMALUR_SCENE_SHA256 must be empty or exactly 64 hexadecimal characters")
    endif()
    target_compile_definitions(opem_amalur_scene PRIVATE AMALUR_SCENE_SHA256="${AMALUR_SCENE_SHA256}")
  endif()
  target_link_libraries(opem_amalur_scene PRIVATE aaudio amalur_scene_mesh android log EGL GLESv3 m dl)
  target_compile_options(opem_amalur_scene PRIVATE -Wall -Wextra -Wpedantic)
  target_link_options(opem_amalur_scene PRIVATE "-Wl,-z,max-page-size=16384" "-Wl,-z,common-page-size=16384")
endif()
